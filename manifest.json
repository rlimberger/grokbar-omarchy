{
  "schemaVersion": 1,
  "id": "rlimberger.grokbar-omarchy",
  "name": "Grokbar",
  "version": "1.1.0",
  "author": "rlimberger",
  "license": "MIT",
  "description": "SuperGrok weekly pool plus Cursor (X-login only) monthly pools on the bar.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Grokbar",
    "description": "Bar widget with SuperGrok weekly pool plus Cursor (X-login only) monthly pools and reset.",
    "category": "AI",
    "aliases": [
      "grokbar-omarchy"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "authPath": "",
      "stateDbPath": "",
      "cursorAuthPath": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "authPath",
        "type": "path",
        "label": "Grok auth.json",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.grok/auth.json."
      },
      {
        "key": "stateDbPath",
        "type": "path",
        "label": "Cursor state.vscdb",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.config/Cursor/User/globalStorage/state.vscdb."
      },
      {
        "key": "cursorAuthPath",
        "type": "path",
        "label": "Cursor CLI auth.json",
        "defaultValue": "",
        "description": "Optional. Defaults to ~/.config/cursor/auth.json."
      }
    ]
  }
}
